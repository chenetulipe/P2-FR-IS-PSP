        "id": 1,
        "offset": 349064,
        "data_size": 206,
        "slot_size": 206,
        "_term": [
            4358,
            4354,
            4355
        ],
        "nom_orig": "Eikichi",
        "texte_orig": "Then[SP]again,[SP]I'd[SP]been[SP]scared[SP]to[SP]even[SP]say[SP]that\nname[SP]until[SP]now.[1205][000F][SP]Heh...[SP]It's[SP]a[SP]real[SP]load[SP]off.",
        "nom_fr": "Eikichi",
        "texte_fr": "Mais j'avais peur de dire ce nom jusqu'ici.[1205][000F]\nHé... c'est un vrai soulagement."
