            4354,
            5169
        ],
        "nom_orig": "Young[SP]man",
        "texte_orig": "We[SP]finally[SP]figured[SP]it[SP]out.",
        "nom_fr": "Jeune homme",
        "texte_fr": "On a enfin trouvé."
    },
