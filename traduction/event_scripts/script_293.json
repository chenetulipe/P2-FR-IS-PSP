        "data_size": 192,
        "slot_size": 192,
        "_term": [
            4358,
            4354,
            4355
        ],
        "nom_orig": "Young[SP]man",
        "texte_orig": "So[SP]long[SP]as[SP]we're[SP]on[SP]Xibalba,[SP]we're[SP]safe[SP]from\nthe[SP]annihilation[SP]of[SP]the[SP]Earth,[SP]right?",
        "nom_fr": "Jeune homme",
        "texte_fr": "Tant qu'on est sur Xibalba, on est à\nl'abri de la chute de la Terre, non?"
    },
