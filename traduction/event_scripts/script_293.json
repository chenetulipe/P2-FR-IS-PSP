        "data_size": 222,
        "slot_size": 222,
        "_term": [
            4358,
            4354,
            4355
        ],
        "nom_orig": "Young[SP]man",
        "texte_orig": "When[SP]I[SP]thought[SP]about[SP]it[SP]that[SP]way,[SP]I[SP]started\ngetting[SP]curious[SP]about[SP]what's[SP]gonna[SP]happen\ndown[SP]there.",
